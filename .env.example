# root shared env — loaded by all apps via --env-file ../../.env.local
# copy to .env.local and fill real values (never commit .env.local)

# shared infra (required by server, worker, db)
DATABASE_URL="postgresql://user:password@localhost:5432/toku_db"
REDIS_URL="redis://localhost:6379"

# server (fastify http+ws on single PORT)
# PORT is the only port for both http and ws (combined setup)
WEB_ORIGIN="http://localhost:5173"

# worker overrides (if different redis for queue, otherwise uses REDIS_URL)
# WORKER_CONCURRENCY="10"
