{
  "name": "@toku/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "build": "bun build src/index.ts --target bun --outdir dist",
    "check-types": "tsc --noEmit",
    "dev": "bun run --env-file ../../.env --env-file .env.local --hot src/index.ts",
    "lint": "eslint .",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@toku/crypto": "workspace:*",
    "@toku/db": "workspace:*",
    "@toku/env": "workspace:*",
    "@toku/protocol": "workspace:*",
    "@toku/redis": "workspace:*",
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "@toku/eslint-config": "workspace:*",
    "@toku/typescript-config": "workspace:*",
    "@types/bun": "latest"
  }
}
