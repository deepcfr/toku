{
  "name": "@toku/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "build": "bun build src/index.ts --target bun --outdir dist",
    "check-types": "tsc --noEmit",
    "dev": "bun run --env-file ../../.env --hot src/index.ts",
    "lint": "eslint .",
    "start": "bun run dist/index.js",
    "test": "bun test --env-file ../../.env"
  },
  "dependencies": {
    "@toku/db": "workspace:*",
    "@toku/env": "workspace:*",
    "@toku/redis": "workspace:*",
    "bullmq": "^6.7.6",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@toku/eslint-config": "workspace:*",
    "@toku/typescript-config": "workspace:*",
    "@types/bun": "latest",
    "pino-pretty": "^13.2.0"
  }
}
